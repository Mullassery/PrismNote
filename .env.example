# All variables below are optional — the app runs with none of them set,
# just with Google Sign-In and AI features disabled. Verified against what
# the code actually reads (crates/server/src/main.rs, api.rs, ai.rs) as of
# this revision.

# --- Google Sign-In (frontend) ---
# Read by frontend/src/pages/Login.tsx to initialize Google Identity
# Services. Sign-in verifies the ID token server-side against Google's own
# JWKS (crates/server/src/api.rs::auth_google) — no client secret needed,
# so there is no corresponding backend GOOGLE_CLIENT_SECRET variable.
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

# --- AI features (backend) ---
# Setting PRISMNOTE_AI_PROVIDER enables the AI engine (code explain/fix/
# complete, NL-to-SQL) and selects which provider below is used. Leave
# unset to fall back to a previously-saved UI config at
# ~/.prismnote/ai_config.json, or to run with AI features off.
# One of: ollama | claude | openai
PRISMNOTE_AI_PROVIDER=

# Required if PRISMNOTE_AI_PROVIDER=claude
ANTHROPIC_API_KEY=
PRISMNOTE_CLAUDE_MODEL=

# Required if PRISMNOTE_AI_PROVIDER=openai
OPENAI_API_KEY=
PRISMNOTE_OPENAI_MODEL=

# Used if PRISMNOTE_AI_PROVIDER=ollama; PRISMNOTE_OLLAMA_URL defaults to
# http://localhost:11434 in the Ollama client if unset
PRISMNOTE_OLLAMA_URL=
PRISMNOTE_OLLAMA_MODEL=

# RunPod-backed AI fine-tuning/training endpoints (crates/server/src/api.rs
# fine-tuning routes). Unset means those routes run without RunPod access.
RUNPOD_API_KEY=

# --- Backend runtime config ---
# Signs auth JWTs (crates/server/src/middleware/auth.rs). Falls back to the
# hardcoded string "default-secret" if unset — MUST be set to a real random
# secret in any deployment reachable by untrusted clients.
JWT_SECRET=

# Where notebooks are stored. Defaults to ~/.prismnote/notebooks if unset.
PRISMNOTE_DIR=
